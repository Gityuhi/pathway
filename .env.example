# api
API_PORT=
DEV_USER_ID=00000000-0000-0000-0000-000000000001
AUTH_MODE=dev
# required when AUTH_MODE=supabase (Dashboard → Project URL)
SUPABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# database (Supabase Cloud connection string)
DB_SOURCE=

# frontend — set in frontend/.env (Vite reads from frontend/ directory)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# cloud run
WORKLOAD_IDENTITY_PROVIDER=
SERVICE=
REGION=
