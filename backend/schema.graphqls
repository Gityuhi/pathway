# GraphQL schema example
#
# https://gqlgen.com/getting-started/

type Todo {
  id: ID!
  text: String!
  status: TodoStatus!
  user: User!
}

enum TodoStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

type User {
  id: ID!
  name: String!
}

type Query {
  todos: [Todo!]!
}

input NewTodo {
  text: String!
}

input UpdateTodo {
  text: String!
}

input UpdateTodoStatus {
  status: TodoStatus!
}

type Mutation {
  createTodo(input: NewTodo!): Todo!
  deleteTodo(id: ID!): Todo!
  updateTodo(id: ID!, input: UpdateTodo!): Todo!
  updateTodoStatus(id: ID!, input: UpdateTodoStatus!): Todo!
}
